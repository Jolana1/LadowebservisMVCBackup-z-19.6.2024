<!-- This file is controlled via puppet  -->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="aspNetCore" />
      <!-- Clear inherited handlers so customer root web.configs cannot break challenge serving -->
      <clear />
      <add
        name="AcmeStaticFile"
        path="*"
        verb="GET,HEAD"
        modules="StaticFileModule"
        resourceType="File"
        requireAccess="Read"
      />
    </handlers>
    <staticContent>
      <!-- Clear inherited mime maps to avoid duplicate '.' entries causing potential 500.19 -->
      <clear />
      <mimeMap fileExtension="." mimeType="text/plain" />
    </staticContent>
  </system.webServer>

  <system.web>
    <authorization>
      <allow users="*" />
    </authorization>
  </system.web>
</configuration>
